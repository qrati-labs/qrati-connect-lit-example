{
  "name": "qrati-connect-lit-example",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "pnpm run build && wrangler dev --config dist/qrati_connect_lit_example/wrangler.json",
    "deploy": "pnpm run build && wrangler deploy --config dist/qrati_connect_lit_example/wrangler.json"
  },
  "dependencies": {
    "lit": "3.3.3",
    "vanilla-cookieconsent": "3.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.43.0",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "wrangler": "4.109.0"
  }
}
